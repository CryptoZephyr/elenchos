{
  "repository": ".",
  "agent": {
    "provider": "gemini",
    "command": "agy",
    "args": [
      "--agent",
      "gemini",
      "--add-dir",
      "{{cwd}}",
      "--print",
      "{{prompt}}",
      "--output-format",
      "json",
      "--mode",
      "accept-edits",
      "--print-timeout",
      "300s"
    ],
    "timeoutMs": 330000
  },
  "application": {
    "start": "npm run dev",
    "url": "http://127.0.0.1:3000",
    "allowRemoteUrl": false,
    "readinessTimeoutMs": 60000,
    "env": {}
  },
  "verification": {
    "maxRepairAttempts": 2,
    "verifyBeforeImplement": false,
    "retainWorkspace": false,
    "timeoutSeconds": 300,
    "headless": true
  },
  "mcp": {
    "allowVerify": false
  }
}
